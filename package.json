{
  "name": "vastai-mcp",
  "version": "0.1.0",
  "description": "MCP server that provides a workflow-oriented abstraction layer over the vast.ai GPU cloud REST API (no vastai CLI required).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ActiveTK/vastaiMCP.git"
  },
  "keywords": ["mcp", "model-context-protocol", "vast.ai", "vastai", "gpu", "cloud"],
  "bin": {
    "vastai-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md", "README.ja.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ssh2": "^1.17.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
